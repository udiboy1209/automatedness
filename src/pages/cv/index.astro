---
// Unlisted page: not linked from anywhere, reachable only via /cv/
import fs from 'node:fs';
import path from 'node:path';
import { FileText } from '@lucide/astro';

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const cvDir = path.join(process.cwd(), 'public', 'cv');
const files = fs.readdirSync(cvDir)
    .filter((f) => f.toLowerCase().endsWith('.pdf'))
    .sort();

// "MeetUdeshi_resume_agentthreats.pdf" -> "resume agentthreats"
const label = (f) => f.replace(/\.pdf$/i, '').replace(/^MeetUdeshi_/, '').replace(/_/g, ' ');
---

<Layout title="CVs">
    <meta slot="head" name="robots" content="noindex, nofollow" />
    <div class="w-full px-4 lg:w-3/4 lg:mx-auto">
        <Header />
        <h2 class="text-4xl my-8">CVs</h2>
        <ul class="grid grid-cols-1 gap-2">
            {files.map((f) => (
                <li class="flex items-center space-x-2 text-xl">
                    <FileText size={20} />
                    <a class="hover:underline hover:text-blue-400" href={`/cv/${f}`}>{label(f)}</a>
                </li>
            ))}
        </ul>
        <Footer />
    </div>
</Layout>
